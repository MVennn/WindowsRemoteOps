# ---------------------------------------------------------------------------
# host.conf —— 主机配置（本文件不入库）
#
# 用法：复制本文件为 host.conf，把占位符换成真值。
#   cp host/host.conf.example host/host.conf
#
# 读取顺序（tools/verify-host.py）：命令行参数 → 本文件 → 占位符默认值。
# 字段说明见 docs/ARCHITECTURE.md §6。
#
# 注意：host.conf 被 .gitignore 排除。不要把真值提交进版本库。
# ---------------------------------------------------------------------------

# 目标机地址（必填）
host=<HOST-IP>

# 登录用户名（必填）
user=<HOST-USER>

# SSH 端口（可选，默认 22）
port=22

# 私钥路径（可选，默认交给 ssh 自己找，通常是 ~/.ssh/id_ed25519）
# identity=~/.ssh/id_ed25519
